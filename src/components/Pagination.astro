---
import { homePageUrl } from '../utils/posts';

interface Props {
  currentPage: number;
  totalPages: number;
}

const { currentPage, totalPages } = Astro.props;
const newer = currentPage > 1 ? homePageUrl(currentPage - 1) : undefined;
const older = currentPage < totalPages ? homePageUrl(currentPage + 1) : undefined;
---

{
  totalPages > 1 && (
    <nav class="pagination" aria-label="Pagination">
      {newer ? (
        <a href={newer} rel="prev">
          &larr; Newer posts
        </a>
      ) : (
        <span />
      )}
      <span class="status">
        Page {currentPage} of {totalPages}
      </span>
      {older ? (
        <a href={older} rel="next">
          Older posts &rarr;
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}

<style>
  .pagination {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-6);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
  }
  a {
    text-decoration: none;
  }
  a[rel='next'] {
    justify-self: end;
  }
  .status {
    color: var(--color-text-muted);
  }
</style>
