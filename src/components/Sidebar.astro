---
import ProfileCard from './ProfileCard.astro';
import FeaturedPosts from './FeaturedPosts.astro';
import RecentPosts from './RecentPosts.astro';
import ProjectsList from './ProjectsList.astro';
---

<aside class="sidebar" aria-label="Sidebar">
  <ProfileCard />
  <FeaturedPosts />
  <RecentPosts />
  <ProjectsList />
</aside>

<style>
  .sidebar {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }
  /* Sticky only when the viewport is tall enough to show the whole sidebar. */
  @media (min-width: 64rem) and (min-height: 56rem) {
    .sidebar {
      position: sticky;
      top: var(--space-5);
    }
  }
  @media (min-width: 40rem) and (max-width: 63.99rem) {
    .sidebar {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
