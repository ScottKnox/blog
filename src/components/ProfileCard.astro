---
import { Image } from 'astro:assets';
import { site } from '../data/site';
---

<section class="profile" aria-label="About the author">
  <Image class="photo" src={site.photo} alt={site.photoAlt} width={88} height={88} densities={[1, 2]} loading="eager" />
  <p class="name">{site.name}</p>
  <p class="bio">{site.shortBio}</p>
  <a class="more" href="/about">More about me &rarr;</a>
</section>

<style>
  .profile {
    padding: var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font-family: var(--font-sans);
  }
  .photo {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    object-fit: cover;
  }
  .name {
    margin-top: var(--space-4);
    color: var(--color-text);
    font-size: var(--text-lg);
    font-weight: 650;
    line-height: 1.3;
  }
  .bio {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.55;
  }
  .more {
    display: inline-block;
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    text-decoration: none;
  }
</style>
